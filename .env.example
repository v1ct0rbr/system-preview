# Porta publicada no host
APP_PORT=8080

# Configuração do sistema (aplicada em tempo de execução)
SYSTEM_NAME=Aurora
SYSTEM_DESCRIPTION=Uma nova experiência para gerenciar, acompanhar e evoluir suas operações — em um só lugar.
SYSTEM_START_DATE=2026-12-20T09:00:00-03:00
SYSTEM_URL=
# Um ou mais diretórios públicos, separados por vírgula
SYSTEM_BACKGROUND_DIRS=/backgrounds

# Alternativa para desenvolvimento local com "npm run dev"
VITE_SYSTEM_NAME=Aurora
VITE_SYSTEM_DESCRIPTION=Uma nova experiência para gerenciar, acompanhar e evoluir suas operações — em um só lugar.
